# Copy to .env and fill in. All optional: without them the site runs in demo mode
# (orders, reservations, messages and newsletter signups are NOT stored anywhere).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional overrides for the café details (otherwise src/data/siteConfig.js is used)
VITE_SITE_NAME=Bite & Brew
VITE_WHATSAPP_NUMBER=919999999999
VITE_CONTACT_PHONE=+91 99999 99999
VITE_CONTACT_EMAIL=hello@biteandbrew.example
VITE_GOOGLE_MAPS_EMBED_URL=
